<!DOCTYPE html>
<html lang="ru">

<head>
  <meta charset="UTF-8">
  <title>Отряды</title>
  <style>
    body {
      font-family: Arial, sans-serif;
      background-color: #fff;
      color: #000;
      font-size: 12px;
    }

    h1 {
      text-align: center;
      font-size: 18px;
    }

    h2 {
      text-align: center;
      font-size: 14px;
    }

    .skills-table {
      width: 100%;
      border-collapse: collapse;
      font-size: 12px;
      table-layout: fixed;
    }

    .skills-table th:first-child,
    .skills-table td:first-child {
      width: 35%;
      border: 1px solid #ddd;
      text-align: center;
      font-size: 12px;
    }

    .skills-table th:not(:first-child),
    .skills-table td:not(:first-child) {
      width: calc(65% / 13);
      border: 1px solid #ddd;
      text-align: center;
      font-size: 12px;
    }

    .equipment-table {
      width: 100%;
      border-collapse: collapse;
      font-size: 12px;
      table-layout: fixed;
    }

    .equipment-table th,
    .equipment-table td {
      border: 1px solid #ddd;
      text-align: center;
      font-size: 12px;
    }

    .equipment-content {
      height: 100%;
      width: 100%;
      overflow: hidden;
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
    }

    .equipment-table th:first-child,
    .equipment-table td:first-child {
      width: 25%;
    }

    .equipment-table th:last-child,
    .equipment-table td:last-child {
      width: 75%;
    }

    .equipment-table tr {
      height: 35px;
    }

    th {
      background-color: #f2f2f2;
      font-size: 12px;
      text-align: center;
    }

    .vertical-header {
      height: 14%;
      writing-mode: vertical-lr;
      text-align: center;
      vertical-align: middle;
      white-space: nowrap;
    }

    @media print {
      body {
        background-color: #fff;
        color: #000;
        font-size: 12px;
      }
    }
  </style>
</head>

<body>
  {{#each players}}
  {{#each children}}
  <h1>Лист отряда {{name}}</h1>
  {{#if vehicle}}
  <div>Транспорт: {{vehicle.name}}</div>
  {{/if}}
  <h2>Навыки</h2>
  <table class="skills-table">
    <thead>
      <tr>
        <th>Навык</th>
        {{#each children}}
        <th class="vertical-header">{{name}}</th>
        {{/each}}
      </tr>
    </thead>
    <tbody>
      <tr>
        <td>[ВНС] Выносливость</td>
        {{#each children}}
        <td>{{#if (gt skills.END 0)}}{{skills.END}}{{/if}}</td>
        {{/each}}
      </tr>
      <tr>
        <td>[МНВ] Маневрирование</td>
        {{#each children}}
        <td>{{#if (gt skills.MNV 0)}}{{skills.MNV}}{{/if}}</td>
        {{/each}}
      </tr>
      <tr>
        <td>[МСК] Маскировка</td>
        {{#each children}}
        <td>{{#if (gt skills.STE 0)}}{{skills.STE}}{{/if}}</td>
        {{/each}}
      </tr>
      <tr>
        <td>[ВЛН] Влияние</td>
        {{#each children}}
        <td>{{#if (gt skills.IFL 0)}}{{skills.IFL}}{{/if}}</td>
        {{/each}}
      </tr>
      <tr>
        <td>[ЛГК] Логика</td>
        {{#each children}}
        <td>{{#if (gt skills.LOG 0)}}{{skills.LOG}}{{/if}}</td>
        {{/each}}
      </tr>
      <tr>
        <td>[МЕД] Медицина</td>
        {{#each children}}
        <td>{{#if (gt skills.MED 0)}}{{skills.MED}}{{/if}}</td>
        {{/each}}
      </tr>
      <tr>
        <td>[МЕХ] Механика</td>
        {{#each children}}
        <td>{{#if (gt skills.MCH 0)}}{{skills.MCH}}{{/if}}</td>
        {{/each}}
      </tr>
      <tr>
        <td>[ЭЛ] Электроника</td>
        {{#each children}}
        <td>{{#if (gt skills.EL 0)}}{{skills.EL}}{{/if}}</td>
        {{/each}}
      </tr>
      <tr>
        <td>[ВЗР] Взрывчатые вещества</td>
        {{#each children}}
        <td>{{#if (gt skills.TECH_explosives 0)}}{{skills.TECH_explosives}}{{/if}}</td>
        {{/each}}
      </tr>
      <tr>
        <td>[ОП] Огневая поддержка</td>
        {{#each children}}
        <td>{{#if (gt skills.WPN_artillery 0)}}{{skills.WPN_artillery}}{{/if}}</td>
        {{/each}}
      </tr>
      <tr>
        <td>[ГРН] Метательное оружие (гранаты)</td>
        {{#each children}}
        <td>{{#if (gt skills.WPN_grenades 0)}}{{skills.WPN_grenades}}{{/if}}</td>
        {{/each}}
      </tr>
      <tr>
        <td>[ЛС] Лёгкое стрелковое оружие</td>
        {{#each children}}
        <td>{{#if (gt skills.WPN_rifles 0)}}{{skills.WPN_rifles}}{{/if}}</td>
        {{/each}}
      </tr>
      <tr>
        <td>[СН] Снайперское оружие</td>
        {{#each children}}
        <td>{{#if (gt skills.WPN_sniper 0)}}{{skills.WPN_sniper}}{{/if}}</td>
        {{/each}}
      </tr>
      <tr>
        <td>[ПЛМ] Пулемёты</td>
        {{#each children}}
        <td>{{#if (gt skills.WPN_mg 0)}}{{skills.WPN_mg}}{{/if}}</td>
        {{/each}}
      </tr>
      <tr>
        <td>[УР] Управляемые ракеты</td>
        {{#each children}}
        <td>{{#if (gt skills.WPN_guided 0)}}{{skills.WPN_guided}}{{/if}}</td>
        {{/each}}
      </tr>
      <tr>
        <td>[ДРН] Управляемые дроны</td>
        {{#each children}}
        <td>{{#if (gt skills.TECH_uav 0)}}{{skills.TECH_uav}}{{/if}}</td>
        {{/each}}
      </tr>
      <tr>
        <td>[ТВ] Тяжёлое вооружение</td>
        {{#each children}}
        <td>{{#if (gt skills.WPN_heavy 0)}}{{skills.WPN_heavy}}{{/if}}</td>
        {{/each}}
      </tr>
    </tbody>
  </table>
  <h2>Снаряжение</h2>
  <table class="equipment-table">
    <thead>
      <tr>
        <th>Персонаж</th>
        <th>Снаряжение</th>
      </tr>
    </thead>
    <tbody>
      {{#each children}}
      <tr>
        <td>
          {{name}}
        </td>
        <td>
          <div class="equipment-content">
            {{#each equipment}}
            •&nbsp;{{this.name}}{{#if (gt this.ammo 0)}} ({{this.ammo}}){{/if}}
            {{/each}}
          </div>
        </td>
      </tr>
      {{/each}}
    </tbody>
  </table>

  <div style="page-break-after: always;"></div>

  {{/each}}
  {{/each}}
</body>

</html>