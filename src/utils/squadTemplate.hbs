<!DOCTYPE html>
<html lang="ru">

<head>
  <meta charset="UTF-8">
  <title>Отряды</title>
  <style>
    body {
      font-family: Arial, sans-serif;
      background-color: #fff;
      color: #000;
      font-size: 12px;
    }

    h1 {
      text-align: center;
      font-size: 18px;
    }

    table {
      width: 100%;
      border-collapse: collapse;
      font-size: 12px;
    }

    th,
    td {
      border: 1px solid #ddd;
      text-align: left;
      font-size: 12px;
    }

    th {
      background-color: #f2f2f2;
      font-size: 12px;
      text-align: center;
    }

    .vertical-header {
      writing-mode: vertical-lr;
      text-align: center;
      vertical-align: middle;
      white-space: nowrap;
    }

    @media print {
      body {
        background-color: #fff;
        color: #000;
        font-size: 12px;
      }
    }
  </style>
</head>

<body>
  {{#each players}}
  {{#each children}}
  <h1>Лист отряда {{name}}</h1>
  <table>
    <thead>
      <tr>
        <th>Навык</th>
        {{#each children}}
        <th class="vertical-header">{{name}}</th>
        {{/each}}
      </tr>
    </thead>
    <tbody>
      <tr>
        <td>[ВНС] Выносливость</td>
        {{#each children}}
        <td>{{skills.END}}</td>
        {{/each}}
      </tr>
      <tr>
        <td>[МНВ] Маневрирование</td>
        {{#each children}}
        <td>{{skills.MNV}}</td>
        {{/each}}
      </tr>
      <tr>
        <td>[МСК] Маскировка</td>
        {{#each children}}
        <td>{{skills.STE}}</td>
        {{/each}}
      </tr>
      <tr>
        <td>[ВЛН] Влияние</td>
        {{#each children}}
        <td>{{skills.IFL}}</td>
        {{/each}}
      </tr>
      <tr>
        <td>[ЛГК] Логика</td>
        {{#each children}}
        <td>{{skills.LOG}}</td>
        {{/each}}
      </tr>
      <tr>
        <td>[МЕД] Медицина</td>
        {{#each children}}
        <td>{{skills.MED}}</td>
        {{/each}}
      </tr>
      <tr>
        <td>[МЕХ] Механика</td>
        {{#each children}}
        <td>{{skills.MCH}}</td>
        {{/each}}
      </tr>
      <tr>
        <td>[ЭЛ] Электроника</td>
        {{#each children}}
        <td>{{skills.EL}}</td>
        {{/each}}
      </tr>
      <tr>
        <td>[ВЗР] Взрывчатые вещества</td>
        {{#each children}}
        <td>{{skills.TECH_explosives}}</td>
        {{/each}}
      </tr>
      <tr>
        <td>[ОП] Огневая поддержка</td>
        {{#each children}}
        <td>{{skills.WPN_artillery}}</td>
        {{/each}}
      </tr>
      <tr>
        <td>[ГРН] Метательное оружие (гранаты)</td>
        {{#each children}}
        <td>{{skills.WPN_grenades}}</td>
        {{/each}}
      </tr>
      <tr>
        <td>[ЛС] Лёгкое стрелковое оружие</td>
        {{#each children}}
        <td>{{skills.WPN_rifles}}</td>
        {{/each}}
      </tr>
      <tr>
        <td>[СН] Снайперское оружие</td>
        {{#each children}}
        <td>{{skills.WPN_sniper}}</td>
        {{/each}}
      </tr>
      <tr>
        <td>[ПЛМ] Пулемёты</td>
        {{#each children}}
        <td>{{skills.WPN_mg}}</td>
        {{/each}}
      </tr>
      <tr>
        <td>[УР] Управляемые ракеты</td>
        {{#each children}}
        <td>{{skills.WPN_guided}}</td>
        {{/each}}
      </tr>
      <tr>
        <td>[ДРН] Управляемые дроны</td>
        {{#each children}}
        <td>{{skills.TECH_uav}}</td>
        {{/each}}
      </tr>
      <tr>
        <td>[ТВ] Тяжёлое вооружение</td>
        {{#each children}}
        <td>{{skills.WPN_heavy}}</td>
        {{/each}}
      </tr>
    </tbody>
  </table>
  {{/each}}
  {{/each}}
</body>

</html>