<!DOCTYPE html>
<html lang="ru">

<head>
  <meta charset="UTF-8">
  <title>Отряды</title>
  <style>
    body {
      font-family: Arial, sans-serif;
      background-color: #fff;
      color: #000;
      font-size: 12px;
    }

    h1 {
      text-align: center;
      font-size: 18px;
    }

    .skills-table {
      width: 100%;
      border-collapse: collapse;
      font-size: 12px;
      table-layout: fixed;
      background-image: url('/soldier_silhouette_1.png'), url('/soldier_silhouette_2.png');
      background-repeat: no-repeat, no-repeat;
      background-position: top left, bottom right;
      background-size: 80px, 105px;
    }

    .skills-table th:first-child,
    .skills-table td:first-child {
      width: 35%;
      border-right: 1px solid #999;
      border-top: none;
      border-left: none;
      border-bottom: 1px solid #999;
      text-align: center;
      font-size: 12px;
    }

    .skills-table th:not(:first-child),
    .skills-table td:not(:first-child) {
      width: calc(65% / 13);
      border-left: 1px solid #999;
      border-top: none;
      border-right: 1px solid #999;
      border-bottom: 1px solid #999;
      text-align: center;
      font-size: 12px;
    }

    .skills-table thead th {
      border-top: none;
    }

    .skills-table tbody tr:last-child td {
      border-bottom: none;
    }

    .skills-table th:last-child,
    .skills-table td:last-child {
      border-right: none;
    }

    .equipment-table {
      width: 100%;
      border-collapse: collapse;
      font-size: 12px;
      table-layout: fixed;
      background-image: url('/soldier_silhouette_4.png'), url('/soldier_silhouette_3.png');
      background-repeat: no-repeat, no-repeat;
      background-position: top left, bottom right;
      background-size: 70px, 70px;
    }

    .equipment-table th,
    .equipment-table td {
      border-left: 1px solid #999;
      border-top: none;
      border-right: 1px solid #999;
      border-bottom: 1px solid #999;
      text-align: center;
      font-size: 12px;
    }

    .equipment-table thead th {
      border-top: none;
    }

    .equipment-table tbody tr:last-child td {
      border-bottom: none;
    }

    .equipment-table th:first-child,
    .equipment-table td:first-child {
      border-left: none;
    }

    .equipment-table th:last-child,
    .equipment-table td:last-child {
      border-right: none;
    }

    .equipment-content {
      height: 100%;
      width: 100%;
      overflow: hidden;
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
    }

    .equipment-table th:first-child,
    .equipment-table td:first-child {
      width: 23%;
    }

    .equipment-table th:last-child,
    .equipment-table td:last-child {
      width: 77%;
    }

    .equipment-table tr {
      height: 35px;
    }

    th {
      font-size: 12px;
      text-align: center;
    }

    .sheet-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 5px 0;
      margin-bottom: 10px;
      border-bottom: 1px solid #333;
    }

    .sheet-title {
      font-size: 18px;
      font-weight: bold;
      margin: 0;
    }

    .sheet-transport {
      font-size: 18px;
      font-weight: normal;
      margin: 0;
      text-align: right;
    }

    .vertical-header {
      height: 14%;
      writing-mode: vertical-lr;
      text-align: center;
      vertical-align: middle;
      white-space: nowrap;
    }

    @media print {
      table {
        -webkit-print-color-adjust: exact;
        print-color-adjust: exact;
      }
    }
  </style>
</head>

<body>
  {{#each players}}
  {{#each children}}
  <div class="sheet-header">
    <div class="sheet-title">Лист отряда {{name}}</div>
    <div class="sheet-transport">Транспорт: {{#if vehicle}}{{vehicle.name}}{{else}}пешком{{/if}}</div>
  </div>
  <table class="skills-table">
    <thead>
      <tr>
        <th>Навык</th>
        {{#each children}}
        <th class="vertical-header">{{name}}</th>
        {{/each}}
      </tr>
    </thead>
    <tbody>
      <tr>
        <td>[ВНС] Выносливость</td>
        {{#each children}}
        <td>{{#if (gt skills.END 0)}}{{skills.END}}{{/if}}</td>
        {{/each}}
      </tr>
      <tr>
        <td>[МНВ] Маневрирование</td>
        {{#each children}}
        <td>{{#if (gt skills.MNV 0)}}{{skills.MNV}}{{/if}}</td>
        {{/each}}
      </tr>
      <tr>
        <td>[МСК] Маскировка</td>
        {{#each children}}
        <td>{{#if (gt skills.STE 0)}}{{skills.STE}}{{/if}}</td>
        {{/each}}
      </tr>
      <tr>
        <td>[ВЛН] Влияние</td>
        {{#each children}}
        <td>{{#if (gt skills.IFL 0)}}{{skills.IFL}}{{/if}}</td>
        {{/each}}
      </tr>
      <tr>
        <td>[ЛГК] Логика</td>
        {{#each children}}
        <td>{{#if (gt skills.LOG 0)}}{{skills.LOG}}{{/if}}</td>
        {{/each}}
      </tr>
      <tr>
        <td>[МЕД] Медицина</td>
        {{#each children}}
        <td>{{#if (gt skills.MED 0)}}{{skills.MED}}{{/if}}</td>
        {{/each}}
      </tr>
      <tr>
        <td>[МЕХ] Механика</td>
        {{#each children}}
        <td>{{#if (gt skills.MCH 0)}}{{skills.MCH}}{{/if}}</td>
        {{/each}}
      </tr>
      <tr>
        <td>[ЭЛ] Электроника</td>
        {{#each children}}
        <td>{{#if (gt skills.EL 0)}}{{skills.EL}}{{/if}}</td>
        {{/each}}
      </tr>
      <tr>
        <td>[ВЗР] Взрывчатые вещества</td>
        {{#each children}}
        <td>{{#if (gt skills.TECH_explosives 0)}}{{skills.TECH_explosives}}{{/if}}</td>
        {{/each}}
      </tr>
      <tr>
        <td>[ОП] Огневая поддержка</td>
        {{#each children}}
        <td>{{#if (gt skills.WPN_artillery 0)}}{{skills.WPN_artillery}}{{/if}}</td>
        {{/each}}
      </tr>
      <tr>
        <td>[ГРН] Метательное оружие (гранаты)</td>
        {{#each children}}
        <td>{{#if (gt skills.WPN_grenades 0)}}{{skills.WPN_grenades}}{{/if}}</td>
        {{/each}}
      </tr>
      <tr>
        <td>[ЛС] Лёгкое стрелковое оружие</td>
        {{#each children}}
        <td>{{#if (gt skills.WPN_rifles 0)}}{{skills.WPN_rifles}}{{/if}}</td>
        {{/each}}
      </tr>
      <tr>
        <td>[СН] Снайперское оружие</td>
        {{#each children}}
        <td>{{#if (gt skills.WPN_sniper 0)}}{{skills.WPN_sniper}}{{/if}}</td>
        {{/each}}
      </tr>
      <tr>
        <td>[ПЛМ] Пулемёты</td>
        {{#each children}}
        <td>{{#if (gt skills.WPN_mg 0)}}{{skills.WPN_mg}}{{/if}}</td>
        {{/each}}
      </tr>
      <tr>
        <td>[УР] Управляемые ракеты</td>
        {{#each children}}
        <td>{{#if (gt skills.WPN_guided 0)}}{{skills.WPN_guided}}{{/if}}</td>
        {{/each}}
      </tr>
      <tr>
        <td>[ДРН] Управляемые дроны</td>
        {{#each children}}
        <td>{{#if (gt skills.TECH_uav 0)}}{{skills.TECH_uav}}{{/if}}</td>
        {{/each}}
      </tr>
      <tr>
        <td>[ТВ] Тяжёлое вооружение</td>
        {{#each children}}
        <td>{{#if (gt skills.WPN_heavy 0)}}{{skills.WPN_heavy}}{{/if}}</td>
        {{/each}}
      </tr>
    </tbody>
  </table>
  <hr>
  <table class="equipment-table">
    <thead>
      <tr>
        <th>Персонаж</th>
        <th>Снаряжение</th>
      </tr>
    </thead>
    <tbody>
      {{#each children}}
      <tr>
        <td>
          {{name}}
        </td>
        <td>
          <div class="equipment-content">
            {{#each equipment}}
            •&nbsp;{{this.name}}{{#if (gt this.ammo 0)}} ({{this.ammo}}){{/if}}
            {{/each}}
          </div>
        </td>
      </tr>
      {{/each}}
    </tbody>
  </table>

  <div style="page-break-after: always;"></div>

  {{/each}}
  {{/each}}
</body>

</html>